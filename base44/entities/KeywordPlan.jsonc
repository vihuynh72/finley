{
  "name": "KeywordPlan",
  "type": "object",
  "properties": {
    "client_id": { "type": "string" },
    "profile_fingerprint": {
      "type": "string",
      "description": "Hash of the client profile text this plan was built from; a new plan is made only when it changes"
    },
    "model": { "type": "string" },
    "as_of": { "type": "string", "format": "date", "description": "The date the planner was told it is: a backtest plans as of its cutoff. Empty means the day it was created." },
    "keyword_count": { "type": "number" },
    "exposures": {
      "type": "array",
      "description": "Risk indicators: external forces that could move the client's market up or down, most important first. Not financial figures.",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "category": {
            "type": "string",
            "enum": [
              "company_specific", "pricing_competition", "demand_customers", "input_costs", "supply_chain",
              "regulation_policy", "geopolitics_trade", "labor_talent", "macro_financial", "technology_shifts"
            ]
          },
          "driver": { "type": "string", "description": "The client driver or assumption this force moves" },
          "why": { "type": "string" },
          "sensitivity": { "type": "string", "enum": ["high", "medium", "low"] },
          "keywords": { "type": "array", "items": { "type": "string" }, "description": "News search queries for Bright Data" }
        }
      }
    }
  },
  "required": ["client_id", "exposures"]
}
