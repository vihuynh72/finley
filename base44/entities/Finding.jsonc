{
  "name": "Finding",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "agent": {
      "type": "string",
      "enum": [
        "competition",
        "market",
        "risk"
      ]
    },
    "topic": {
      "type": "string",
      "enum": [
        "Input costs",
        "Pricing and competition",
        "Demand and customers",
        "Logistics and freight",
        "Regulation"
      ],
      "description": "Dashboard topic"
    },
    "title": {
      "type": "string"
    },
    "fact": {
      "type": "string",
      "description": "Observed fact from sources"
    },
    "interpretation": {
      "type": "string",
      "description": "Analytical interpretation"
    },
    "why_it_matters": {
      "type": "string"
    },
    "drivers_affected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions_affected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_step": {
      "type": "string"
    },
    "uncertainty": {
      "type": "string"
    },
    "materiality": {
      "type": "number"
    },
    "confidence": {
      "type": "number"
    },
    "urgency": {
      "type": "number"
    },
    "priority": {
      "type": "number"
    },
    "relevance": {
      "type": "number",
      "description": "Source reliability, 0-100"
    },
    "scores": {
      "type": "object",
      "description": "0-100 display scores",
      "properties": {
        "priority": {
          "type": "number"
        },
        "materiality": {
          "type": "number"
        },
        "relevance": {
          "type": "number"
        },
        "confidence": {
          "type": "number"
        },
        "urgency": {
          "type": "number"
        }
      }
    },
    "is_alert": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "outlet": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "Primary company",
              "Trade press",
              "Government",
              "Blog unverified"
            ],
            "description": "Source type, decided by code from the outlet and URL (shared/sources.ts)"
          },
          "tier": {
            "type": "number",
            "description": "Default reliability tier 1-4 (1 = filings and government, 4 = unverified blogs); analysts can override per source (SourceOverride)"
          }
        }
      }
    },
    "impact": {
      "type": "object",
      "properties": {
        "revenue_pct": {
          "type": "number"
        },
        "cost_pct": {
          "type": "number"
        },
        "margin_pts": {
          "type": "number"
        },
        "cash_flow_pct": {
          "type": "number"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending",
        "validated",
        "rejected",
        "needs_research"
      ],
      "default": "pending",
      "description": "Analyst decision. Dashboard terms: pending = open, validated = added to forecast review, needs_research = needs research, rejected = dismissed"
    },
    "feedback": {
      "type": "string"
    },
    "incorporate": {
      "type": "boolean",
      "default": false
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Observed facts, one per cited development"
    },
    "change_view": {
      "type": "string",
      "description": "What would most change this assessment"
    },
    "effect": {
      "type": "string",
      "enum": [
        "challenged",
        "under_pressure",
        "supported",
        "holding"
      ],
      "description": "How it bears on the client's assumptions"
    },
    "exposure": {
      "type": "string",
      "description": "Name of the keyword-plan exposure (dashboard tab) whose searches found most of its sources; empty when only company or competitor searches did"
    },
    "topic_key": {
      "type": "string",
      "description": "The pipeline's topic (input_costs, pricing_competition, demand_customers, logistics_freight, regulation)"
    },
    "event_date": {
      "type": "string",
      "description": "ISO day of the newest cited article"
    },
    "impact_inputs": {
      "type": "object",
      "description": "The impact estimator's inputs (pnl_line, shock_pct, exposure_pct, pass_through_pct, shock_min_pct, shock_max_pct, persistence, quarters, effect), used to fill a topic's sliders"
    }
  },
  "required": [
    "client_id",
    "title"
  ]
}
