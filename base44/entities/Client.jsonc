{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "business_model": {
      "type": "string"
    },
    "revenue_streams": {
      "type": "string"
    },
    "cost_structure": {
      "type": "string"
    },
    "financial_drivers": {
      "type": "string"
    },
    "strategic_objectives": {
      "type": "string"
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "annual_revenue": {
      "type": "number",
      "description": "USD millions"
    },
    "gross_margin_pct": {
      "type": "number"
    },
    "opex": {
      "type": "number",
      "description": "USD millions"
    },
    "ev_ebitda_multiple": {
      "type": "number"
    },
    "ticker": {
      "type": "string",
      "description": "Stock ticker if the company is listed (e.g. NVDA). Optional: when empty, scans look the company up by name and treat it as private if no listing matches."
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "driver": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "monitoring",
              "supported",
              "challenged",
              "under_review"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "reforecast_due": {
      "type": "string",
      "format": "date",
      "description": "Next reforecast date; the dashboard counts down to it"
    },
    "eval_case": {
      "type": "string",
      "description": "Set on clients created by a backtest (e.g. netflix-2023): the profile as of the case's cutoff. Empty for real clients."
    },
    "rec_decisions": {
      "type": "object",
      "description": "Analyst decisions on recommendations: recommendation id -> open | accepted | snoozed | dismissed"
    },
    "source_overrides": {
      "type": "object",
      "description": "Analyst source tier overrides: outlet name -> { tier, reason, at }"
    },
    "last_run_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name"
  ]
}